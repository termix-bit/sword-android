<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Sword" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sword_background</item>
        <item name="android:statusBarColor">@color/sword_background</item>
        <item name="android:navigationBarColor">@color/sword_deep_navy</item>
    </style>

    <style name="Theme.Sword.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sword_deep_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sword_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Sword</item>
    </style>
</resources>
